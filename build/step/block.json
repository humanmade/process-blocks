{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "process-blocks/step",
  "version": "0.1.0",
  "title": "Process Step",
  "category": "text",
  "parent": [
    "process-blocks/process",
    "process-blocks/section"
  ],
  "description": "A single step in a process, with a title and any content.",
  "textdomain": "process-blocks",
  "attributes": {
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    }
  },
  "usesContext": [
    "process-blocks/headingLevel"
  ],
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}