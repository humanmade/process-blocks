{
	"name": "process-blocks",
	"version": "0.1.0",
	"description": "Step-by-step process blocks for the block editor.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"author": "Human Made",
	"files": [
		"build",
		"inc",
		"plugin.php",
		"readme.txt"
	],
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"dev": "npm run build && npm run env:start",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"playground": "npm run build && wp-playground-cli server --auto-mount --blueprint=blueprint.local.json --login",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"lint:js": "eslint src",
		"lint:css": "stylelint \"src/**/*.scss\"",
		"lint:php": "composer run lint",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.29.9",
		"@humanmade/eslint-config": "^2.1.0",
		"@humanmade/stylelint-config": "^1.3.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/eslint-plugin": "^20.3.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/interactivity": "^6.56.0",
		"@wordpress/scripts": "^36.0.0",
		"@wp-playground/cli": "^3.1.56",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"stylelint": "^16.26.1"
	}
}
